{
  "name": "battery-controller-analyzer",
  "description": "Unit tests for the browser-side DP optimizer and diagnostics analyzer",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "test:perf": "node docs/__perf__/dp_benchmark.js"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/docs/__tests__/**/*.test.js"
    ],
    "coverageDirectory": "coverage-js",
    "collectCoverageFrom": [
      "docs/analyzer/analyzer.js"
    ]
  }
}
